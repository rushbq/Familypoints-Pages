  "narrative": {
    "northStar": "Sweet Home",
    "overview": "Sweet Home 是一座放在掌心裡的家庭花園：家長能在忙碌的日常中快速完成紀錄，孩子則能清楚看到努力如何累積成目標與獎勵。畫面以薄荷綠霧面背景、白色資訊表面、可可棕文字與圓潤字體形成溫暖基底，再用晴空藍、杏桃橘、日光黃與獎勵薰衣草區分功能。童趣只出現在有助辨識與回饋的地方；手機是主要情境。",
    "keyCharacteristics": ["薄荷霧面背景與白色內容表面", "圓潤但清楚的單一字體系統", "以功能角色分配的柔和全彩色盤", "可按壓、狀態明確的主要操作", "手機優先、桌面漸進增強的結構", "裝飾必須服從資訊對比與可辨識性"],
    "rules": [
      { "name": "The One Job Per Color Rule", "body": "綠代表正向與主要確認，藍代表資訊，橘代表目標與成就，紫代表兌換，紅代表錯誤或負向；禁止為了熱鬧任意交換角色。", "section": "colors" },
      { "name": "The Visible Flower Rule", "body": "小花只能放在具足夠明暗差的純色或低紋理表面；若背景與花瓣接近，必須改用深色花心、加白色隔離輪廓，或移除花朵。", "section": "colors" },
      { "name": "The Read Once Rule", "body": "家長與孩子都應一次讀懂；主要內容使用完整文字與清楚層級，不以小字、低對比或裝飾性字距換取精緻感。", "section": "typography" },
      { "name": "The One Boundary Rule", "body": "卡片用色調、邊框或陰影其中一種建立邊界；禁止同時使用 1px 邊框與 16px 以上模糊陰影。", "section": "elevation" },
      { "name": "The State, Not Spectacle Rule", "body": "動態只回應選取、開啟、按壓與狀態變更；一般 transition 介於 150–250ms，並提供 reduced-motion 替代。", "section": "elevation" }
    ],
    "dos": ["Do 以手機 390px 寬度為主要檢查基準。", "Do 讓小花與其他品牌圖示在實際背景上清楚可見。", "Do 讓童趣服務於辨識成員、狀態或獎勵。"],
    "donts": ["Don't 採用企業後台般冰冷、複雜或高密度的視覺語言。", "Don't 過度幼兒化，也不要堆疊大量卡通裝飾而干擾操作。", "Don't 塑造成遊戲商城。", "Don't 讓低對比的小花消失在薄荷與白色背景中。"]
  }
