  "narrative": {
    "northStar": "Sweet Home",
    "overview": "Sweet Home 是一座放在掌心裡的家庭花園：從 Pikmin Bloom 官網擷取明亮自然、花朵、嫩芽與戶外色彩的氣質，但不複製角色、商標或圖像素材。畫面以花園霧綠、白色資訊表面、深葉綠文字與圓潤字體形成溫暖基底；手機首屏優先呈現目標、孩子分數與主要操作。",
    "keyCharacteristics": ["花園霧綠背景與白色內容表面", "圓潤但清楚的單一字體系統", "以功能角色分配的自然全彩色盤", "緊湊、可按壓且狀態明確的主要操作", "手機優先、桌面漸進增強的結構", "裝飾必須服從資訊對比與可辨識性"],
    "rules": [
      { "name": "The One Job Per Color Rule", "body": "綠代表正向與主要確認，藍代表資訊，橘代表目標與成就，紫代表兌換，紅代表錯誤或負向；禁止為了熱鬧任意交換角色。", "section": "colors" },
      { "name": "The Visible Flower Rule", "body": "小花只能放在具足夠明暗差的純色或低紋理表面；若背景與花瓣接近，必須改用深色花心、加白色隔離輪廓，或移除花朵。", "section": "colors" },
      { "name": "The Read Once Rule", "body": "家長與孩子都應一次讀懂；主要內容使用完整文字與清楚層級，不以小字、低對比或裝飾性字距換取精緻感。", "section": "typography" },
      { "name": "The One Boundary Rule", "body": "卡片用色調、邊框或陰影其中一種建立邊界；禁止同時使用 1px 邊框與 16px 以上模糊陰影。", "section": "elevation" },
      { "name": "The State, Not Spectacle Rule", "body": "動態只回應選取、開啟、按壓與狀態變更；一般 transition 介於 150–250ms，並提供 reduced-motion 替代。", "section": "elevation" },
      { "name": "The One Scroll Rule", "body": "手機設定與日誌使用頁面自然捲動；不得在主要內容裡再放固定高度捲軸。", "section": "components" }
    ],
    "dos": ["Do 以手機 390px 寬度為主要檢查基準。", "Do 讓家長首屏同時看見目標、兩位孩子分數與主要操作。", "Do 讓小花與其他品牌圖示在實際背景上清楚可見。", "Do 讓童趣服務於辨識成員、狀態或獎勵。", "Do 以單一加扣分頁籤同步表單與清單。"],
    "donts": ["Don't 採用企業後台般冰冷、複雜或高密度的視覺語言。", "Don't 過度幼兒化，也不要堆疊大量卡通裝飾而干擾操作。", "Don't 塑造成遊戲商城。", "Don't 讓低對比的小花消失在薄荷與白色背景中。", "Don't 在手機主要內容加入巢狀捲軸或過量 Emoji。"]
  }
}
